{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/tooltip/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Epilogue|Libre Franklin|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Epilogue, Libre Franklin, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:cost|tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: cost, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrumbItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<CrumbItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|leftIcon|rightIcon|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, leftIcon, rightIcon, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|mark|title|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: variant, mark, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:note|tip|warning|danger|success)$/]",
        "message": "<Callout> variant must be one of 'note' | 'tip' | 'warning' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChampionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|cost|traits|portrait|key|ref|className|style|children)$/]",
        "message": "<ChampionCard> doesn't accept that prop. Declared props: name, cost, traits, portrait."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|count|removable|children|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, count, removable, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuideCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|level|number|duration|lessons|cover|as|key|ref|className|style|children)$/]",
        "message": "<GuideCard> doesn't accept that prop. Declared props: title, description, level, number, duration, lessons, cover, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardUnit'] > JSXAttribute > JSXIdentifier[name!=/^(?:row|col|name|cost|stars|portrait|key|ref|className|style|children)$/]",
        "message": "<BoardUnit> doesn't accept that prop. Declared props: row, col, name, cost, stars, portrait."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|kind|stats|description|recipe|key|ref|className|style|children)$/]",
        "message": "<ItemTooltip> doesn't accept that prop. Declared props: name, icon, kind, stats, description, recipe."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, key, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|kbd|onClear|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: size, kbd, onClear."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SearchInput> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|icon|badge|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: label, key, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|gold|teal|solid|outline)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'gold' | 'teal' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|count|active|description|tiers|activeTier|key|ref|className|style|children)$/]",
        "message": "<TraitCard> doesn't accept that prop. Declared props: name, icon, count, active, description, tiers, activeTier."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnitStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<UnitStat> doesn't accept that prop. Declared props: label, value."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
