{
  "name": "baron-tft-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:release": "eslint src tests next.config.ts playwright.config.ts vitest.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:sync": "node scripts/convert-evergreen-lessons.mjs",
    "content:slugs": "tsx scripts/db/generate-set18-slugs.ts",
    "content:search-index": "tsx scripts/db/generate-search-index.ts",
    "content:validate-tips": "tsx scripts/db/validate-set18-tips.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "tsx scripts/db/deny-db-push.ts",
    "db:check-schema": "dotenv -e .env.local -- tsx scripts/db/check-schema-drift.ts",
    "db:validate-constraints": "dotenv -e .env.local -- tsx scripts/db/validate-constraints.ts",
    "db:migrate:apply": "dotenv -e .env.local -- tsx scripts/db/apply-migration.ts",
    "db:ensure-tips-table": "dotenv -e .env.local -- tsx scripts/db/ensure-set18-tips-table.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/db/seed-set18.ts",
    "db:pull": "dotenv -e .env.local -- tsx scripts/db/pull-set18.ts",
    "db:pull:check": "dotenv -e .env.local -- tsx scripts/db/pull-set18.ts check",
    "db:apply-patch": "dotenv -e .env.local -- tsx scripts/db/apply-patch-draft.ts",
    "db:apply-patch:dry-run": "dotenv -e .env.local -- tsx scripts/db/apply-patch-draft.ts dry-run",
    "db:apply-changeset:dry-run": "dotenv -e .env.local -- tsx scripts/db/apply-changeset-dry-run.ts",
    "db:apply-changeset": "dotenv -e .env.local -- tsx scripts/db/apply-changeset.ts",
    "db:apply-tip": "dotenv -e .env.local -- tsx scripts/db/apply-tip-draft.ts",
    "db:publish-audit": "dotenv -e .env.local -- tsx scripts/db/audit-publish.ts",
    "db:audit-tip-links": "dotenv -e .env.local -- tsx scripts/db/audit-tip-links.ts",
    "db:verify": "dotenv -e .env.local -- tsx scripts/db/verify.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "perf:smoke": "node scripts/check-route-bundles.mjs",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project=desktop-chromium"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^15.3.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.13.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.4",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "marked": "^18.0.9",
    "tsx": "^4.23.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
