# Copy file này thành .env.local (đã gitignore) rồi điền connection string thật.
# Lấy từ Vercel Dashboard → project → Storage → database Postgres (Neon) →
# tab ".env.local" → copy dòng DATABASE_URL (hoặc POSTGRES_URL, đổi tên lại
# thành DATABASE_URL cho khớp drizzle.config.ts / src/db/client.ts).
#
# KHÔNG dán connection string thật vào file này — file này được commit vào git.

DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DB_TARGET_LABEL=local

# Mật khẩu riêng để mở /quan-ly/gop-y. Dùng một chuỗi ngẫu nhiên dài và chỉ cấu
# hình ở .env.local/Vercel; không đặt biến này với tiền tố NEXT_PUBLIC_.
FEEDBACK_ADMIN_TOKEN=replace-with-a-long-random-secret

# Secret riêng để băm IP trước khi rate-limit. Tạo giá trị ngẫu nhiên khác với
# FEEDBACK_ADMIN_TOKEN; tuyệt đối không đưa vào biến NEXT_PUBLIC_.
FEEDBACK_RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret
